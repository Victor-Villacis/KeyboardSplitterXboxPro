═══ Phase Shift (Guitar) ═══
name = "Phase Shift (Guitar)"

[bindings]
A = "LeftShift"
B = "Z"
X = "C"
Y = "X"
back = "Space"
"dpad.down" = "Down"
"dpad.left" = "Left"
"dpad.right" = "Right"
"dpad.up" = "Up"
rb = "V"
start = "Tab"

═══ Pro Evolution Soccer ═══
name = "Pro Evolution Soccer"

[bindings]

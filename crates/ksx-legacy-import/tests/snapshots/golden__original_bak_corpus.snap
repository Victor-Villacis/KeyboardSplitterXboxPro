"lx.max" = "Right"
"lx.min" = "Left"
"ly.max" = "Up"
"ly.min" = "Down"
rb = "E"
rt = "C"
rthumb = "RightShift"
"rx.max" = "Numpad6"
"rx.min" = "Numpad4"
"ry.max" = "Numpad8"
"ry.min" = "Numpad2"
start = "Escape"


═══ Phase Shift (Autostrum) ═══
name = "Phase Shift (Autostrum)"

[bindings]
A = "LeftShift"
B = "Z"
X = "C"
Y = "X"
back = "Space"
"dpad.down" = ["Down", "LeftShift", "Z", "X", "C", "V"]
"dpad.left" = "Left"
"dpad.right" = "Right"
"dpad.up" = "Up"
rb = "V"
start = "Tab"
